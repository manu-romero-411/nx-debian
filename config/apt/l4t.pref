# apt preferences for the L4T repository. @L4T_HOST@ is the repository's
# host name (filled in by nxd).

# The Tegra r32 driver stops at Xorg 1.20 (video ABI 24); Debian's server is
# newer, so these must come from the L4T repository whatever Debian offers.
Package: xserver-xorg-core xserver-xorg-input-libinput xserver-xorg-video-fbdev xserver-common
Pin: origin "@L4T_HOST@"
Pin-Priority: 1001

# Anything else the repository has: only where Debian has nothing.
Package: *
Pin: origin "@L4T_HOST@"
Pin-Priority: 100
