<?xml version="1.0" encoding="UTF-8"?>
<!-- The Openbox of the console: no window or desktop shortcuts, nor menus.
     The volume and power buttons of the Switch are keys of the X server;
     Openbox takes them (EmulationStation would ask to configure its keyboard
     when it saw them) and does what they say. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <keyboard>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute"><command>nxd-volume up</command></action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute"><command>nxd-volume down</command></action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute"><command>nxd-volume mute</command></action>
    </keybind>
    <!-- The power button is logind's (standby, see logind.conf.d). Openbox
         only grabs the key so that EmulationStation does not see it. -->
    <keybind key="XF86PowerOff"/>
  </keyboard>
</openbox_config>
