# System packages every variant gets. Debian names (trixie). Recommends are
# not installed (see build-rootfs.sh), so everything wanted is listed here.

# Init, devices, sessions
systemd-sysv
systemd-timesyncd
udev
dbus
dbus-user-session
libpam-systemd
kmod
sudo
polkitd
pkexec
ca-certificates

# Remote access (also makes nvfb generate the host keys on the first boot)
openssh-server

# A text editor, and the dialog frontend of debconf (without it, apt falls back
# to a plain prompt and complains about every package that asks something)
nano
whiptail
# The system at a glance, in a terminal or over ssh
fastfetch

# Disks and filesystems: what GParted needs and suggests, so that any
# partition can be checked, resized or made from the console (nxd-growfs uses
# e2fsprogs to grow the root filesystem on the first boot). Not dmraid (it
# brings up fake RAID sets at boot) nor reiserfsprogs/reiser4progs.
parted
fdisk
gdisk
e2fsprogs
dosfstools
exfatprogs
mtools
ntfs-3g
btrfs-progs
xfsprogs
f2fs-tools
jfsutils
udftools
gpart
dmsetup
kpartx
# Network and Bluetooth
network-manager
wpasupplicant
iw
rfkill
wireless-regdb
bluez

# Audio (the per-user PulseAudio the current image already uses)
alsa-utils
alsa-ucm-conf
pulseaudio
pulseaudio-utils
pulseaudio-module-bluetooth

# Replaces the hand-made zram setup of the old build.sh
systemd-zram-generator

# Console tools for diagnosing on the device (killall, chvt)
psmisc
kbd
# The font of the text consoles (Terminus 8x16: nxd-common sets it)
console-setup
# The locales (the common ones of Europe: nxd-common has them generated)
locales
