# System packages every variant gets. Debian names (trixie). Recommends are
# not installed (see build-rootfs.sh), so everything wanted is listed here.

# Init, devices, sessions
systemd-sysv
systemd-timesyncd
udev
dbus
dbus-user-session
libpam-systemd
kmod
sudo
polkitd
pkexec
ca-certificates

# Remote access (also makes nvfb generate the host keys on the first boot)
openssh-server

# Network and Bluetooth
network-manager
wpasupplicant
iw
rfkill
wireless-regdb
bluez

# Audio (the per-user PulseAudio the current image already uses)
alsa-utils
alsa-ucm-conf
pulseaudio
pulseaudio-utils
pulseaudio-module-bluetooth

# Replaces the hand-made zram setup of the old build.sh
systemd-zram-generator

# Console tools for diagnosing on the device (killall, chvt)
psmisc
kbd
