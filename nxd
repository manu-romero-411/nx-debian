#!/usr/bin/env bash
# nxd: build driver of the Switchroot Debian images.
set -euo pipefail

NXD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export NXD_ROOT
# shellcheck source=scripts/lib/common.sh
. "${NXD_ROOT}/scripts/lib/common.sh"

usage() {
    cat << 'EOF'
Usage: nxd COMMAND [options]

  spike [options]         does Debian + the L4T repository resolve? (apt, no root)
  rootfs [options]        build the root filesystem of a variant
  image [options]         turn a rootfs into the SD card installer for Hekate (root)
  build [options]         rootfs + report + image of one or every variant, files to publish (root)
  inspect [options]       report what is inside a built rootfs (no root)
  container COMMAND ...   run any of these in a Debian trixie container
  variants [--all]        list the variants (--all: the experimental ones too)
  packages VARIANT        print the package set of a variant

Every command takes --help.
EOF
}

command="${1:-}"
[[ $# -gt 0 ]] && shift

case "${command}" in
    spike) exec "${NXD_ROOT}/scripts/spike-l4t.sh" "$@" ;;
    rootfs) exec "${NXD_ROOT}/scripts/build-rootfs.sh" "$@" ;;
    image) exec "${NXD_ROOT}/scripts/build-image.sh" "$@" ;;
    build) exec "${NXD_ROOT}/scripts/build-variants.sh" "$@" ;;
    inspect) exec "${NXD_ROOT}/scripts/inspect-rootfs.sh" "$@" ;;
    container) exec "${NXD_ROOT}/scripts/in-container.sh" "$@" ;;
    variants)
        case "${1:-}" in
            "" | --all) ;;
            *) die "usage: nxd variants [--all]" ;;
        esac
        while IFS= read -r name; do
            description="$(variant_setting "${name}" NXD_VARIANT_DESCRIPTION)"
            if [[ "$(variant_setting "${name}" NXD_EXPERIMENTAL)" == 1 ]]; then
                description="(experimental) ${description}"
            fi
            printf '%-10s %s\n' "${name}" "${description}"
        done < <(list_variants "${1:-}")
        ;;
    packages)
        [[ $# -eq 1 ]] || die "usage: nxd packages VARIANT"
        variant_packages "$1"
        ;;
    -h | --help | help | "")
        usage
        ;;
    *)
        usage >&2
        die "unknown command: ${command}"
        ;;
esac
