#!/bin/sh
# nxd-common: enables nxd-nvpmodel-restore.service and nxd-growfs.service the
# first time (an upgrade
# keeps what the administrator chose), and has the locales of
# /usr/share/nxd/locales generated, gives back to root the files of the
# image's overlay that older images left to the user, and replaces
# Switchroot's UCM profile with one that leaves the volume alone.
#
# The Switch's Wi-Fi/Bluetooth chip asks for firmware files under
# other names than the ones the L4T packages ship: link them, and rebuild the
# module dependencies of the L4T kernel (4.9.140-l4t). Run on install and again
# whenever a package changes those folders (see triggers). Everything is
# conditional: a system without those files is left alone.
set -eu

firmware() {
    fwdir=/usr/lib/firmware/brcm
    [ -d "${fwdir}" ] || return 0
    if [ -e "${fwdir}/brcmfmac4356A3-pcie.bin" ]; then
        ln -sf brcmfmac4356A3-pcie.bin "${fwdir}/brcmfmac4356-pcie.bin"
    fi
    if [ -e "${fwdir}/brcmfmac4356A3-pcie.txt" ]; then
        ln -sf brcmfmac4356A3-pcie.txt "${fwdir}/brcmfmac4356-pcie.txt"
        for model in switch odin vali fric; do
            cp -f "${fwdir}/brcmfmac4356A3-pcie.txt" "${fwdir}/brcmfmac4356-pcie.nintendo,${model}.txt"
        done
    fi
    if [ -e "${fwdir}/BCM4356A3.hcd" ]; then
        ln -sf BCM4356A3.hcd "${fwdir}/bcm4356.hcd"
    fi
}

modules() {
    command -v depmod > /dev/null 2>&1 || return 0
    for moddir in /usr/lib/modules/*l4t*; do
        [ -d "${moddir}" ] || continue
        depmod -a "$(basename "${moddir}")"
    done
}

# the Switch's UCM profile without the lines that set the volume to 100%
# (made from Switchroot's, diverted by preinst; again whenever that changes)
ucm() {
    [ -x /usr/lib/nxd/ucm-volume ] || return 0
    /usr/lib/nxd/ucm-volume || echo "nxd-common: the UCM profile could not be made" >&2
}

# the common locales of Europe, generated (Retrobox offers the languages that
# are; see /usr/share/nxd/locales): on every configure, so that a locale the
# list gains reaches the consoles that are installed already
locales() {
    [ -x /usr/lib/nxd/ensure-locales ] || return 0
    /usr/lib/nxd/ensure-locales || echo "nxd-common: the locales could not be generated" >&2
}

# console_font: Terminus (regular, not bold), 8x16, for the text consoles,
# in /etc/default/console-setup and in debconf (so that a dpkg-reconfigure of
# console-setup keeps it). Only on the first install: a font chosen later stays.
console_font() {
    file=/etc/default/console-setup
    [ -f "${file}" ] || return 0
    for key in FONTFACE FONTSIZE; do
        grep -q "^${key}=" "${file}" || echo "${key}=" >> "${file}"
    done
    sed -i -e 's/^FONTFACE=.*/FONTFACE="Terminus"/' -e 's/^FONTSIZE=.*/FONTSIZE="8x16"/' "${file}"
    if command -v debconf-set-selections > /dev/null 2>&1; then
        printf '%s\n' \
            "console-setup console-setup/fontface47 select Terminus" \
            "console-setup console-setup/fontsize-text47 select 8x16" \
            "console-setup console-setup/fontsize-fb47 select 8x16" | debconf-set-selections
    fi
}

# root_owned: images built before the fix had /etc and the overlay's files
# (hostname, hosts, fstab) owned by the image's user (uid 1000, the checkout's
# owner), and timedated and localed (root, with no CAP_DAC_OVERRIDE) could not
# set the time zone, the keyboard or the language. Only those, only when they
# are the user's.
root_owned() {
    for path in /etc /etc/hostname /etc/hosts /etc/fstab; do
        [ -e "${path}" ] || continue
        [ "$(stat -c %u "${path}")" = 0 ] || chown -h root:root "${path}"
    done
}

units() {
    for unit in nxd-nvpmodel-restore.service nxd-growfs.service; do
        deb-systemd-helper unmask "${unit}" > /dev/null || true
        if deb-systemd-helper --quiet was-enabled "${unit}"; then
            deb-systemd-helper enable "${unit}" > /dev/null || true
        else
            deb-systemd-helper update-state "${unit}" > /dev/null || true
        fi
    done
}

case "${1:-}" in
    configure)
        # $2 is the version that was installed before: none on a first install
        [ -n "${2:-}" ] || console_font
        root_owned
        units
        locales
        ucm
        firmware
        modules
        ;;
    triggered)
        ucm
        firmware
        modules
        ;;
    *) ;;
esac
exit 0
