#!/bin/sh
# nxd-common: forgets nxd-nvpmodel-restore.service and gives the UCM profile
# back to switch-alsa-ucm2; on purge, the firmware
# names postinst made (they belong to no package) go too.
set -eu

case "${1:-}" in
    remove) deb-systemd-helper mask nxd-nvpmodel-restore.service > /dev/null || true ;;
    purge)
        deb-systemd-helper purge nxd-nvpmodel-restore.service > /dev/null || true
        deb-systemd-helper unmask nxd-nvpmodel-restore.service > /dev/null || true
        ;;
    *) ;;
esac

# Switchroot's UCM profile goes back in its place (the one ucm-volume made
# belongs to no package). On abort-install too, as preinst may have diverted
# it already.
case "${1:-}" in
    remove | abort-install)
        ucm=/usr/share/alsa/ucm2/Tegra/tegra-snd-t210ref-mobile-rt565x/HiFi.conf
        if [ -e "${ucm}.switch-alsa-ucm2" ]; then
            rm -f "${ucm}"
        fi
        dpkg-divert --package nxd-common --rename \
            --divert "${ucm}.switch-alsa-ucm2" --remove "${ucm}" > /dev/null
        ;;
    *) ;;
esac

if [ "${1:-}" = purge ]; then
    fwdir=/usr/lib/firmware/brcm
    rm -f "${fwdir}/brcmfmac4356-pcie.bin" "${fwdir}/brcmfmac4356-pcie.txt" "${fwdir}/bcm4356.hcd"
    for model in switch odin vali fric; do
        rm -f "${fwdir}/brcmfmac4356-pcie.nintendo,${model}.txt"
    done
    rm -rf /var/lib/nxd
fi
exit 0
