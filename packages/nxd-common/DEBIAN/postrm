#!/bin/sh
# nxd-common: forgets nxd-nvpmodel-restore.service; on purge, the firmware
# names postinst made (they belong to no package) go too.
set -eu

case "${1:-}" in
    remove) deb-systemd-helper mask nxd-nvpmodel-restore.service > /dev/null || true ;;
    purge)
        deb-systemd-helper purge nxd-nvpmodel-restore.service > /dev/null || true
        deb-systemd-helper unmask nxd-nvpmodel-restore.service > /dev/null || true
        ;;
    *) ;;
esac

if [ "${1:-}" = purge ]; then
    fwdir=/usr/lib/firmware/brcm
    rm -f "${fwdir}/brcmfmac4356-pcie.bin" "${fwdir}/brcmfmac4356-pcie.txt" "${fwdir}/bcm4356.hcd"
    for model in switch odin vali fric; do
        rm -f "${fwdir}/brcmfmac4356-pcie.nintendo,${model}.txt"
    done
    rm -rf /var/lib/nxd
fi
exit 0
