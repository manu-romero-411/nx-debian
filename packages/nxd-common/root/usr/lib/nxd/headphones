#!/usr/bin/env bash
# headphones: puts the Switch's sound on the headphones while they are
# plugged into the jack, and back on the speaker when they are taken out.
#
#   headphones [--once]
#
# In Switchroot's UCM profile the speaker and the headphones are different
# profiles of the card ("HiFi (DummyMic, Speaker)", "HiFi (DummyMic,
# Headphones)"...), and PulseAudio does not change the profile when the jack
# says the headphones are there: it only marks their port available. This
# does: the profile with the same input and the other output.
#
# It runs once at start and again on every card event of PulseAudio
# (pactl subscribe), and acts only when the jack changes: a profile chosen
# by hand (the overlay's audio page, pavucontrol...) stays until the
# headphones are plugged in or taken out. Each output keeps its own volume
# (they are different sinks to PulseAudio).
#
# Anti-flicker: the driver reports the jack unstably, and the unit restarts
# every few seconds, so every decision is checked against a state file in
# tmpfs (${XDG_RUNTIME_DIR:-/tmp}/nxd-headphones.state): an unseen jack change
# is confirmed stable first, two profile changes are never closer than
# NXD_HEADPHONES_COOLDOWN seconds apart, and a switch that would come too
# early is deferred to the next event.
#
# The state file is in tmpfs, not on the SD card; the log only says anything
# when a profile actually changes.
#
# Run for each user by nxd-headphones.service (systemd's user manager).
# --once applies it once and exits (for the tests).
set -uo pipefail

log() { printf 'nxd-headphones: %s\n' "$*" >&2; }

# State: jack ("0"/"1"), seconds when the last profile was changed, and a
# pending jack to switch to, deferred by the cooldown ("" when there is none).
STATE="${NXD_HEADPHONES_STATE:-${XDG_RUNTIME_DIR:-/tmp}/nxd-headphones.state}"
COOLDOWN="${NXD_HEADPHONES_COOLDOWN:-5}"
DEBOUNCE="${NXD_HEADPHONES_DEBOUNCE:-0.75}"

# What read_card finds in `pactl list cards`, for the card with a headphones
# port: its name, its active profile, whether the headphones are plugged in,
# and the names of its profiles.
CARD=""
ACTIVE=""
PLUGGED=""
PROFILES=()

read_card() {
    local line name="" active="" plugged="" section=""
    local -a profiles=()
    CARD="" ACTIVE="" PLUGGED="" PROFILES=()
    while IFS= read -r line || [[ -n "${line}" ]]; do
        case "${line}" in
            "Card #"*)
                [[ -n "${plugged}" ]] && break
                name="" active="" plugged="" section="" profiles=()
                ;;
            $'\t'"Name: "*) name="${line#*Name: }" ;;
            $'\t'"Active Profile: "*) active="${line#*Active Profile: }" ;;
            $'\t'"Profiles:"*) section=profiles ;;
            $'\t'"Ports:"*) section=ports ;;
            $'\t'[A-Za-z]*) section="" ;;
            $'\t\t'"[Out] Headphones: "*)
                [[ "${section}" == ports ]] || continue
                if [[ "${line}" == *"not available)" ]]; then plugged=0; else plugged=1; fi
                ;;
            $'\t\t'[!$'\t']*)
                [[ "${section}" == profiles ]] || continue
                line="${line#$'\t\t'}"
                profiles+=("${line%%: *}")
                ;;
            *) ;;
        esac
    done < <(LC_ALL=C pactl list cards 2> /dev/null)
    [[ -n "${plugged}" ]] || return 1
    CARD="${name}" ACTIVE="${active}" PLUGGED="${plugged}" PROFILES=("${profiles[@]}")
}

# devices PROFILE: the devices of a profile ("HiFi (DummyMic, Speaker)"), one
# a line, sorted
devices() {
    local inside="${1#*(}"
    inside="${inside%)*}"
    tr ',' '\n' <<< "${inside}" | sed 's/^ *//; s/ *$//' | sort
}

# swapped FROM TO: the profile of the card whose devices are those of the
# active one with FROM replaced by TO; nothing if there is none
swapped() {
    local from="$1" to="$2" want profile
    want="$(devices "${ACTIVE}" | sed "s/^${from}\$/${to}/" | sort)"
    for profile in "${PROFILES[@]}"; do
        [[ "${profile%% (*}" == "${ACTIVE%% (*}" ]] || continue
        if [[ "$(devices "${profile}")" == "${want}" ]]; then
            printf '%s\n' "${profile}"
            return 0
        fi
    done
    return 1
}

STATE_JACK=""
STATE_AT="0"
STATE_PENDING=""

read_state() {
    STATE_JACK="" STATE_AT="0" STATE_PENDING=""
    [[ -f "${STATE}" ]] || return 0
    local line n=1
    while IFS= read -r line || [[ -n "${line}" ]]; do
        case "${n}" in
            1) STATE_JACK="${line}" ;;
            2) STATE_AT="${line}" ;;
            3) STATE_PENDING="${line}" ;;
        esac
        n=$((n + 1))
    done < "${STATE}"
    [[ -z "${STATE_JACK}" ]] && STATE_AT="0" && STATE_PENDING=""
}

write_state() {
    local tmp
    tmp="$(mktemp "${STATE}.XXXXXX" 2> /dev/null)" || return 0
    printf '%s\n%s\n%s\n' "${1}" "${2}" "${3}" > "${tmp}" || { rm -f "${tmp}"; return 0; }
    chmod 644 "${tmp}" 2> /dev/null || true
    mv -f "${tmp}" "${STATE}" 2> /dev/null || rm -f "${tmp}"
}

apply() {
    local target
    read_card || return 0
    # a profile of devices ("HiFi (...)"), not "off" or another one
    [[ "${ACTIVE}" == *"("*")" ]] || return 0

    read_state

    # Nothing changed and nothing deferred: no work at all.
    if [[ -n "${STATE_JACK}" && "${PLUGGED}" == "${STATE_JACK}" && -z "${STATE_PENDING}" ]]; then
        return 0
    fi

    # The jack changed (or this is the first run): the port flaps in this
    # driver, so it must read stable over DEBOUNCE seconds before anything
    # is decided.
    if [[ -z "${STATE_JACK}" || "${PLUGGED}" != "${STATE_JACK}" ]]; then
        sleep "${DEBOUNCE}"
        read_card || return 0
        [[ "${ACTIVE}" == *"("*")" ]] || return 0
        # Back to the old state: a flicker, not a change.
        [[ -n "${STATE_JACK}" && "${PLUGGED}" == "${STATE_JACK}" ]] && return 0
    fi

    local now
    now="$(date +%s)"

    # Cooldown: at most one profile change per COOLDOWN seconds. A switch
    # that would come too early is deferred to the next event instead of
    # flapping the profile.
    if [[ $(( now - STATE_AT )) -lt ${COOLDOWN} ]]; then
        write_state "${PLUGGED}" "${STATE_AT}" "${PLUGGED}"
        return 0
    fi

    if [[ "${PLUGGED}" -eq 1 ]]; then
        [[ "$(devices "${ACTIVE}")" != *Headphones* ]] || { write_state "${PLUGGED}" "${STATE_AT}" ""; return 0; }
        target="$(swapped Speaker Headphones)" || { write_state "${PLUGGED}" "${STATE_AT}" ""; return 0; }
    else
        [[ "$(devices "${ACTIVE}")" == *Headphones* ]] || { write_state "${PLUGGED}" "${STATE_AT}" ""; return 0; }
        target="$(swapped Headphones Speaker)" || { write_state "${PLUGGED}" "${STATE_AT}" ""; return 0; }
    fi

    log "${CARD}: ${ACTIVE} -> ${target}"
    if pactl set-card-profile "${CARD}" "${target}"; then
        write_state "${PLUGGED}" "${now}" ""
    else
        log "cannot set the profile ${target}"
        write_state "${PLUGGED}" "${STATE_AT}" ""
    fi
}

if [[ "${1:-}" == --once ]]; then
    apply
    exit 0
fi

command -v pactl > /dev/null 2>&1 || { log "pactl is not installed"; exit 1; }
# PulseAudio may still be starting
for _ in $(seq 1 30); do
    pactl info > /dev/null 2>&1 && break
    sleep 1
done
apply
# Card events only: every other event (clients, sinks, sources, server) is
# ignored cheaply by the same filter, so a busy session costs one line read
# and nothing else. When PulseAudio goes, pactl ends and so does this (the
# unit starts it again).
LC_ALL=C pactl subscribe 2> /dev/null | while IFS= read -r event; do
    [[ "${event}" == *" on card "* ]] && apply
done
