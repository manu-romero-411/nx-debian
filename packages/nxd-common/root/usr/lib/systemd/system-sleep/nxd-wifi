#!/bin/sh
# The Wi-Fi driver across a suspend: unloaded before it, loaded again after
# it (see /etc/default/nxd-suspend, NXD_SUSPEND_UNLOAD_WIFI).
#
# brcmfmac (the Switch's BCM4356, on PCIe) took 0.95 s of the 1.41 s that
# suspending the devices took; without it, 0.46 s. At the resume it is
# loaded again in a transient service of its own (nxd-wifi-resume), so that
# the hook does not keep the end of the suspend waiting for the firmware;
# NetworkManager then connects again by itself. Only a driver that was
# loaded is loaded again (a marker in /run).
#
# NXD_SUSPEND_CONFIG, NXD_WIFI_STATE_DIR and NXD_MODULE_DIR are for the tests.

config="${NXD_SUSPEND_CONFIG:-/etc/default/nxd-suspend}"
marker="${NXD_WIFI_STATE_DIR:-/run}/nxd-wifi.unloaded"
modules="${NXD_MODULE_DIR:-/sys/module}"
module=brcmfmac
NXD_SUSPEND_UNLOAD_WIFI=yes
# shellcheck source=/dev/null
[ -r "${config}" ] && . "${config}"

case "${1:-}" in
    pre)
        rm -f "${marker}"
        [ "${NXD_SUSPEND_UNLOAD_WIFI}" = yes ] || exit 0
        [ -d "${modules}/${module}" ] || exit 0
        if modprobe -r "${module}"; then
            : > "${marker}"
        else
            echo "nxd-wifi: could not unload ${module}: it suspends with the rest" >&2
        fi
        ;;
    post)
        [ -e "${marker}" ] || exit 0
        rm -f "${marker}"
        if ! systemd-run --no-block --collect --quiet --unit=nxd-wifi-resume \
            modprobe "${module}" 2> /dev/null; then
            modprobe "${module}" || echo "nxd-wifi: could not load ${module} again" >&2
        fi
        ;;
    *) ;;
esac
exit 0
