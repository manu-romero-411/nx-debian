#!/bin/sh
# nxd-retrobox: enables nxd-sdcard.service the first time (an upgrade keeps
# what the administrator chose), the way debhelper does it; moves a console
# from the old nxd-retrobox session to retrobox-openbox; and writes the
# console's polkit rule for its user when it is missing (consoles made before
# the image's hook config/hooks/retrobox/30-retrobox-polkit.sh did).
set -eu

unit=nxd-sdcard.service
case "${1:-}" in
    configure | abort-upgrade | abort-deconfigure | abort-remove)
        deb-systemd-helper unmask "${unit}" > /dev/null || true
        if deb-systemd-helper --quiet was-enabled "${unit}"; then
            deb-systemd-helper enable "${unit}" > /dev/null || true
        else
            deb-systemd-helper update-state "${unit}" > /dev/null || true
        fi
        ;;
    *) ;;
esac

# The console's session is now retrobox-session-openbox's (retrobox-openbox):
# a console set up with the old nxd-retrobox session logs into the new one.
autologin=/etc/lightdm/lightdm.conf.d/50-nxd-autologin.conf
if [ "${1:-}" = configure ] && [ -f "${autologin}" ] &&
    grep -qx 'autologin-session=nxd-retrobox' "${autologin}"; then
    sed -i 's/^autologin-session=nxd-retrobox$/autologin-session=retrobox-openbox/' "${autologin}"
fi

# The session's steps were in /etc/retrobox-system-settings/session.d, which
# the session doesn't read any more: they are in /etc/retrobox/session.d now,
# with the rest of Retrobox's configuration. The old copies (conffiles this
# package no longer ships) go.
if [ "${1:-}" = configure ]; then
    for old in 50-nxd-emulationstation 60-nxd-capture-button; do
        rm -f "/etc/retrobox-system-settings/session.d/${old}" \
            "/etc/retrobox-system-settings/session.d/${old}.dpkg-old" \
            "/etc/retrobox-system-settings/session.d/${old}.dpkg-dist"
    done
    rmdir /etc/retrobox-system-settings/session.d /etc/retrobox-system-settings 2> /dev/null || true
fi

# needs retrobox-system-settings: when it comes in the same update but after
# this package, the next update writes the rule
rule=/etc/polkit-1/rules.d/50-retrobox-console.rules
user="$(getent passwd 1000 | cut -d: -f1 || true)"
if [ "${1:-}" = configure ] && [ ! -e "${rule}" ] && [ -n "${user}" ] &&
    command -v retrobox-polkit-rule > /dev/null 2>&1; then
    mkdir -p /etc/polkit-1/rules.d
    retrobox-polkit-rule "${user}" > "${rule}"
    chmod 644 "${rule}"
fi
exit 0
