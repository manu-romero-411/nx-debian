#!/bin/sh
# The nxd-retrobox session (lightdm logs the user of the image into it):
# Openbox with the console's key bindings, which starts the compositor and
# Retrobox (retrobox-autostart).
#
# Before that, the defaults of EmulationStation for the Switch (its pad, the
# Nintendo button layout, the text size) are put in the user's Retrobox
# configuration when they are not there yet: EmulationStation rewrites those
# files, so they are the user's from then on.
set -eu

share=/usr/share/nxd/retrobox
config="${RETROBOX_CONFIGDIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/retrobox}"
frontend="${config}/frontend/.emulationstation"
mkdir -p "${frontend}"
for file in es_input.cfg es_settings.cfg; do
    [ -e "${frontend}/${file}" ] || cp "${share}/emulationstation/${file}" "${frontend}/${file}"
done

# A user's own rc.xml wins over the console's
rc="${XDG_CONFIG_HOME:-${HOME}/.config}/openbox/rc.xml"
[ -e "${rc}" ] || rc="${share}/openbox/rc.xml"
exec openbox --config-file "${rc}" --startup /usr/lib/nxd/retrobox-autostart
