#!/bin/bash
# picom across a suspend: close it and reopen it the same way at the resume.
#
# Suspending with picom alive leaves the screen black on the resume (the
# compositor does not survive the suspend with the X server). So picom is
# killed before the suspend and reopened after the resume — but only when it
# was running at the suspend: a session that never had a compositor (the
# XFCE desktop, or [openbox] compositor: none) is left alone, and a session
# that has no compositor at all is not given one.
#
# The reopening is the same as the session's: the same user, the same
# environment and the same invocation that ran it before the suspend
# (recorded in the markers before the suspend; the graphics environment of
# the session that was open at the suspend is respected), in a transient
# service, nxd-picom-resume (see the post step). The markers are
# in /run, which is tmpfs: an interrupted suspend leaves none behind.
#
# The markers live in the variable NXD_PICOM_STATE_DIR (/run by default):
# tests point it at a scratch folder.

case "${1:-}" in
pre|post) ;;
*) exit 0 ;;
esac

STATE_DIR="${NXD_PICOM_STATE_DIR:-/run}"
ENV="${STATE_DIR}/nxd-picom.env"
USER="${STATE_DIR}/nxd-picom.user"
CMD="${STATE_DIR}/nxd-picom.cmd"

# running PID: whether the process is there and not a zombie (one that has
# ended and is not reaped yet)
running() {
    [ -d "/proc/$1" ] && ! grep -q '^State:[[:space:]]*Z' "/proc/$1/status" 2>/dev/null
}

# The pid of the running picom (not a zombie), or nothing. No procps: read
# /proc directly.
picom_pid() {
    local comm pid
    for comm in /proc/[0-9]*/comm; do
        [ -r "${comm}" ] || continue
        if [ "$(cat "${comm}" 2>/dev/null)" = "picom" ]; then
            pid="$(basename "$(dirname "${comm}")")"
            # a picom that has ended and is not reaped yet is not running
            grep -q '^State:[[:space:]]*Z' "/proc/${pid}/status" 2>/dev/null && continue
            [ -n "${pid}" ] && printf '%s\n' "${pid}" && return 0
        fi
    done
    return 1
}

case "${1}" in
pre)
    # markers from an interrupted or failed suspend: none must survive
    rm -f "${ENV}" "${USER}" "${CMD}"
    pid="$(picom_pid)" || exit 0
    [ -n "${pid}" ] || exit 0
    uid="$(awk '/^Uid:/{print $2; exit}' "/proc/${pid}/status" 2>/dev/null)"
    [ -n "${uid}" ] || { rm -f "${ENV}" "${USER}" "${CMD}"; exit 0; }
    echo "${uid}" > "${USER}"
    tr '\0' '\n' < "/proc/${pid}/environ" > "${ENV}" 2>/dev/null || { rm -f "${ENV}" "${USER}" "${CMD}"; exit 0; }
    tr '\0' ' ' < "/proc/${pid}/cmdline" > "${CMD}" 2>/dev/null || { rm -f "${ENV}" "${USER}" "${CMD}"; exit 0; }
    # killed outright: picom took half a second to end after SIGTERM, all of
    # it added to the time before the system freezes (the X server and the
    # kernel free what it held either way)
    kill -KILL "${pid}" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
        running "${pid}" || exit 0
        sleep 0.05
    done
    ;;
post)
    [ -r "${ENV}" ] && [ -r "${USER}" ] && [ -r "${CMD}" ] || exit 0
    if [ -n "$(picom_pid)" ]; then
        # already reopened by whatever happened in between: leave it
        rm -f "${ENV}" "${USER}" "${CMD}"
        exit 0
    fi
    uid="$(cat "${USER}")"
    user="$(id -nu "${uid}" 2>/dev/null)"
    if [ -z "${user}" ]; then
        echo "nxd-picom: cannot tell who ran picom (uid ${uid}): no compositor" >&2
        rm -f "${ENV}" "${USER}" "${CMD}"
        exit 0
    fi
    cmd="$(cat "${CMD}")"
    # the exact environment that ran it, replayed for the reopening
    mapfile -t env_pairs < "${ENV}"
    env_args=()
    for pair in "${env_pairs[@]}"; do
        case "${pair}" in
        *=*) env_args+=("${pair}") ;;
        esac
    done
    rm -f "${ENV}" "${USER}" "${CMD}"
    [ -n "${cmd}" ] || exit 0
    # In a unit of its own: run from here, picom would belong to
    # systemd-suspend.service, and systemd kills whatever is left in a
    # service's cgroup when it ends, which is a moment after the resume: the
    # compositor was gone again, and the session tore. So a transient service
    # of the system's, as the user and with the session's environment, and
    # without -b/--daemon, so that the unit lives as long as picom does. It
    # waits a moment (NXD_PICOM_RESUME_DELAY, 1 s) for the display to be back.
    words=()
    read -ra all <<< "${cmd}"
    for word in "${all[@]}"; do
        case "${word}" in
        -b | --daemon) ;;
        *) words+=("${word}") ;;
        esac
    done
    gid="$(id -g "${user}" 2>/dev/null)"
    if command -v systemd-run > /dev/null 2>&1 && [ -n "${gid}" ]; then
        systemctl reset-failed nxd-picom-resume.service 2> /dev/null || true
        # shellcheck disable=SC2016 # expanded by that sh, not by this one
        if systemd-run --no-block --collect --quiet --unit=nxd-picom-resume \
            --uid="${uid}" --gid="${gid}" -p Type=exec \
            -- env -i "${env_args[@]}" sh -c 'sleep "$0"; exec "$@"' \
            "${NXD_PICOM_RESUME_DELAY:-1}" "${words[@]}"; then
            exit 0
        fi
    fi
    # no systemd-run: as before (picom may not outlive the suspend's service)
    runuser -u "${user}" -- env -i "${env_args[@]}" sh -c "${cmd}" || \
        echo "nxd-picom: could not reopen picom (${cmd}): no compositor" >&2
    ;;
esac
exit 0
