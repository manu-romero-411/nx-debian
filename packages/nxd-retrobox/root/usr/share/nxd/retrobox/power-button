#!/usr/bin/python3
"""The Switch's power button: a tap suspends, holding it opens the power menu.

Started by the session's step 61-nxd-power-button (nxd-retrobox) and ended
with the session. Released before HOLD seconds, the button suspends the
console (systemctl suspend); held for HOLD seconds, it opens the Retrobox
overlay's power options (retrobox-overlay --power: sleep, restart, turn off)
at once, without waiting for the release.

The Switch's button (max77620_onoff, the PMIC's) sends KEY_SLEEP, which
logind calls the suspend key, not KEY_POWER; KEY_POWER counts as the same
button too. logind handles it
by itself (HandleSuspendKey=suspend, HandlePowerKey=suspend in
/etc/systemd/logind.conf.d/10-nxd-power.conf) whenever this is not running:
the step runs it under a handle-power-key and handle-suspend-key inhibitor,
which tells logind to leave the button to it. What it finds and does goes to
the session's log (the step sends it to
~/.local/state/retrobox/logs/power-button.log).

The press that wakes the console up is not a new tap: whatever the button
does in the second after a resume is ignored. It reads /dev/input, as the
input group (Retrobox puts the user there).
"""
# pylint: disable=invalid-name  # an installed command, named like one

from __future__ import annotations

import os
import selectors
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

# how long the button must be held for the power menu, in seconds
HOLD = 1.0
# what the button does this long after a resume is ignored, in seconds
WAKE_GUARD = 1.0
# how often the devices are looked for again, in seconds
RESCAN = 5.0
# a device with more keys than this is a keyboard, not the console's button
MAX_KEYS = 8

# the codes the console's button may send (linux/input-event-codes.h)
KEY_POWER = 116
KEY_SLEEP = 142
BUTTON_KEYS = (KEY_SLEEP, KEY_POWER)


def suspended_for() -> float:
    """How long the machine has been suspended since it booted, in seconds
    (CLOCK_MONOTONIC stops while it sleeps, CLOCK_BOOTTIME does not)."""
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()


@dataclass
class Button:
    """What the button is doing: when it went down, and what is decided.

    press() and release() take the button's events, tick() the passing of
    time; each returns "suspend", "menu" or None, the action to take.
    """

    hold: float = HOLD
    guard: float = WAKE_GUARD
    down_at: float | None = None
    fired: bool = False
    ignore_until: float = 0.0
    slept: float = field(default_factory=suspended_for)

    def woke(self, now: float, slept: float) -> None:
        """A resume (SLEPT grew): the button is ignored for a while."""
        if slept - self.slept > 0.5:
            self.ignore_until = now + self.guard
            self.down_at = None
            self.fired = False
        self.slept = slept

    def press(self, now: float) -> str | None:
        """The button went down."""
        if now < self.ignore_until:
            return None
        self.down_at = now
        self.fired = False
        return None

    def release(self, now: float) -> str | None:
        """The button went up: a tap if the menu did not open meanwhile."""
        down_at, fired = self.down_at, self.fired
        self.down_at = None
        self.fired = False
        if down_at is None or fired or now < self.ignore_until:
            return None
        return "suspend" if now - down_at < self.hold else "menu"

    def tick(self, now: float) -> str | None:
        """Time passing: the menu opens as soon as the button was held HOLD."""
        if self.down_at is None or self.fired or now - self.down_at < self.hold:
            return None
        self.fired = True
        return "menu"

    def timeout(self, now: float) -> float | None:
        """How long until tick() may have something to do, in seconds."""
        if self.down_at is None or self.fired:
            return None
        return max(self.down_at + self.hold - now, 0.0)


def find_overlay() -> str | None:
    """retrobox-overlay: in the PATH, else next to the retrobox command (its
    bin/), else in $RETROBOX_ROOTDIR/bin or /opt/retrobox/bin."""
    retrobox = shutil.which("retrobox")
    root = os.environ.get("RETROBOX_ROOTDIR")
    candidates = [
        shutil.which("retrobox-overlay"),
        str(Path(retrobox).resolve().parent / "retrobox-overlay") if retrobox else None,
        str(Path(root) / "bin" / "retrobox-overlay") if root else None,
        "/opt/retrobox/bin/retrobox-overlay",
    ]
    return next((c for c in candidates if c and os.access(c, os.X_OK)), None)


def run(command: list[str]) -> None:
    """Starts COMMAND without waiting for it (SIGCHLD is ignored)."""
    try:
        subprocess.Popen(  # pylint: disable=consider-using-with
            command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
    except OSError as error:
        print(f"power-button: {command[0]}: {error}", file=sys.stderr)


def act(action: str, overlay: str | None) -> None:
    """Does ACTION: suspends, or opens the overlay's power options."""
    print(f"power-button: {action}", file=sys.stderr, flush=True)
    if action == "menu" and overlay:
        run([overlay, "--power"])
    elif action == "suspend" or not overlay:
        run(["systemctl", "suspend"] if shutil.which("systemctl") else ["loginctl", "suspend"])


class Devices:
    """The power buttons among the input devices, found again every RESCAN."""

    def __init__(self) -> None:
        import evdev  # pylint: disable=import-outside-toplevel
        self.evdev = evdev
        self.selector = selectors.DefaultSelector()
        self.known: dict[str, object] = {}
        self.next_scan = 0.0

    def scan(self, now: float) -> None:
        """Adds the power buttons that appeared."""
        if now < self.next_scan:
            return
        self.next_scan = now + RESCAN
        ecodes = self.evdev.ecodes
        for path in self.evdev.list_devices():
            if path in self.known:
                continue
            try:
                device = self.evdev.InputDevice(path)
            except OSError:
                continue
            keys = device.capabilities().get(ecodes.EV_KEY, [])
            if any(key in keys for key in BUTTON_KEYS) and len(keys) <= MAX_KEYS:
                self.known[path] = device
                self.selector.register(device, selectors.EVENT_READ)
                print(f"power-button: {path} ({device.name})", file=sys.stderr, flush=True)
            else:
                device.close()

    def values(self, timeout: float) -> list[int]:
        """The values of the button's events (1 down, 0 up, 2 repeat) that
        come within TIMEOUT seconds."""
        values: list[int] = []
        for key, _ in self.selector.select(timeout=max(timeout, 0.01)):
            device = key.fileobj
            try:
                events = list(device.read())
            except OSError:
                self.selector.unregister(device)
                self.known.pop(device.path, None)
                continue
            values += [event.value for event in events
                       if event.type == self.evdev.ecodes.EV_KEY and event.code in BUTTON_KEYS]
        return values


def main() -> int:
    """Wait for the power button until the session ends."""
    overlay = find_overlay()
    if overlay is None:
        print("power-button: retrobox-overlay is not installed: a hold suspends too",
              file=sys.stderr)
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)
    devices = Devices()
    button = Button()
    while True:
        now = time.monotonic()
        button.woke(now, suspended_for())
        devices.scan(now)
        waits = [devices.next_scan - now, 1.0, button.timeout(now)]
        wait = min(w for w in waits if w is not None)
        for value in devices.values(wait):
            now = time.monotonic()
            button.woke(now, suspended_for())
            action = {1: button.press, 0: button.release}.get(value, lambda _: None)(now)
            if action:
                act(action, overlay)
        action = button.tick(time.monotonic())
        if action:
            act(action, overlay)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(main())
