#!/usr/bin/python3
"""The Switch's power button: a tap suspends, holding it opens the power menu.

Started by the session's step 61-nxd-power-button (nxd-retrobox) and ended
with the session. Released before HOLD seconds (0.65), the button suspends the
console (systemctl suspend); held for HOLD seconds, it opens the Retrobox
overlay's power options (retrobox-overlay --power: sleep, restart, turn off)
at once, without waiting for the release.

On a tap the screen goes dark at once: the kernel takes about a second and a
half to suspend the devices, and the display is among the last. The
backlight is turned off (bl_power 4, which nxd-common's udev rule lets the
video group write); without one that it may write, X's DPMS (xset dpms force
off, which the Switch's X driver ignores). At the resume it is lit again.

The Switch's button (max77620_onoff, the PMIC's) sends KEY_SLEEP, which
logind calls the suspend key, not KEY_POWER; KEY_POWER counts as the same
button too. logind handles it
by itself (HandleSuspendKey=suspend, HandlePowerKey=suspend in
/etc/systemd/logind.conf.d/10-nxd-power.conf) whenever this is not running:
the step runs it under a handle-power-key and handle-suspend-key inhibitor,
which tells logind to leave the button to it. What it finds and does goes to
the session's log (the step sends it to
~/.local/state/retrobox/logs/power-button.log).

After a suspend this asked for, the button does nothing for SUSPEND_WINDOW
seconds of CLOCK_MONOTONIC, which stops while the console sleeps: a press
while the console is still going to sleep is ignored, and so is the one that
wakes it up (the time it took to fall asleep is well within the window, so
it is still open at the resume). When the window closes the screen is lit,
in case the suspend never came. Whatever the button does in the second after
a resume that the clocks show (CLOCK_BOOTTIME or CLOCK_REALTIME jumping ahead
of CLOCK_MONOTONIC) is ignored too; the Switch's L4T kernel does not move
CLOCK_BOOTTIME on a suspend, so the clocks alone missed it. It reads /dev/input, as the
input group (Retrobox puts the user there).
"""
# pylint: disable=invalid-name  # an installed command, named like one

from __future__ import annotations

import os
import selectors
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

# how long the button must be held for the power menu, in seconds
HOLD = 0.65
# what the button does this long after a resume is ignored, in seconds
WAKE_GUARD = 1.0
# how long the button does nothing after a suspend this asked for, in seconds
# of CLOCK_MONOTONIC (which stops while the console sleeps): falling asleep
# takes about 2.5 s of it, the rest covers the press that wakes it up
SUSPEND_WINDOW = 5.0
# how often the devices are looked for again, in seconds
RESCAN = 5.0
# a device with more keys than this is a keyboard, not the console's button
MAX_KEYS = 8

# the codes the console's button may send (linux/input-event-codes.h)
KEY_POWER = 116
KEY_SLEEP = 142
BUTTON_KEYS = (KEY_SLEEP, KEY_POWER)


def suspended_for() -> float:
    """How far CLOCK_BOOTTIME and CLOCK_REALTIME are ahead of CLOCK_MONOTONIC,
    in seconds: it grows with each suspend where either of them goes on while
    the machine sleeps (CLOCK_MONOTONIC stops)."""
    mono = time.monotonic()
    return (time.clock_gettime(time.CLOCK_BOOTTIME) - mono) + (time.time() - mono)


@dataclass
class Button:
    """What the button is doing: when it went down, and what is decided.

    press() and release() take the button's events, tick() the passing of
    time; each returns "suspend", "menu", "settled" (the window after a
    suspend closed: light the screen, in case it never came) or None, the
    action to take.
    """

    hold: float = HOLD
    down_at: float | None = None
    fired: bool = False
    ignore_until: float = 0.0
    slept: float = field(default_factory=suspended_for)
    asleep_at: float | None = None
    swallow: bool = False

    def sleeping(self, now: float) -> None:
        """A suspend was asked for: the button does nothing for a while."""
        self.asleep_at = now
        self.down_at = None
        self.fired = False

    def woke(self, now: float, slept: float) -> bool:
        """A resume (SLEPT grew): the button is ignored for a while.
        Whether there was one."""
        resumed = slept - self.slept > 0.5
        if resumed:
            self.ignore_until = now + WAKE_GUARD
            self.down_at = None
            self.fired = False
            self.asleep_at = None
        self.slept = slept
        return resumed

    def press(self, now: float) -> str | None:
        """The button went down."""
        if now < self.ignore_until:
            return None
        if self.asleep_at is not None and now - self.asleep_at < SUSPEND_WINDOW:
            self.swallow = True
            return None
        self.down_at = now
        self.fired = False
        return None

    def release(self, now: float) -> str | None:
        """The button went up: a tap if the menu did not open meanwhile."""
        down_at, fired = self.down_at, self.fired
        self.down_at = None
        self.fired = False
        if self.swallow:
            self.swallow = False
            return None
        if down_at is None or fired or now < self.ignore_until:
            return None
        return "suspend" if now - down_at < self.hold else "menu"

    def tick(self, now: float) -> str | None:
        """Time passing: the menu opens as soon as the button was held HOLD,
        and the window after a suspend closes."""
        if self.asleep_at is not None and now - self.asleep_at >= SUSPEND_WINDOW:
            self.asleep_at = None
            return "settled"
        if self.down_at is None or self.fired or now - self.down_at < self.hold:
            return None
        self.fired = True
        return "menu"

    def timeout(self, now: float) -> float | None:
        """How long until tick() may have something to do, in seconds."""
        if self.down_at is None or self.fired:
            return None
        return max(self.down_at + self.hold - now, 0.0)


def log(message: str) -> None:
    """A line of the log, with the time to the millisecond (to measure)."""
    stamp = time.strftime("%H:%M:%S") + f".{int(time.time() * 1000) % 1000:03d}"
    print(f"{stamp} power-button: {message}", file=sys.stderr, flush=True)


def find_overlay() -> str | None:
    """retrobox-overlay: in the PATH, else next to the retrobox command (its
    bin/), else in $RETROBOX_ROOTDIR/bin or /opt/retrobox/bin."""
    retrobox = shutil.which("retrobox")
    root = os.environ.get("RETROBOX_ROOTDIR")
    candidates = [
        shutil.which("retrobox-overlay"),
        str(Path(retrobox).resolve().parent / "retrobox-overlay") if retrobox else None,
        str(Path(root) / "bin" / "retrobox-overlay") if root else None,
        "/opt/retrobox/bin/retrobox-overlay",
    ]
    return next((c for c in candidates if c and os.access(c, os.X_OK)), None)


def run(command: list[str]) -> None:
    """Starts COMMAND without waiting for it (SIGCHLD is ignored)."""
    try:
        subprocess.Popen(  # pylint: disable=consider-using-with
            command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
    except OSError as error:
        log(f"{command[0]}: {error}")


class Screen:
    """Darkens the screen before a suspend and lights it at the resume: the
    backlight's bl_power when the user may write it, else X's DPMS (xset),
    leaving DPMS enabled or not as it found it."""

    def __init__(self, backlights: str = "/sys/class/backlight") -> None:
        self.backlights = Path(backlights)
        self.xset = shutil.which("xset") if os.environ.get("DISPLAY") else None
        self.dark: list[Path] | None = None
        self.dpms_was_on = True

    def _xset(self, *args: str) -> str:
        if not self.xset:
            return ""
        try:
            return subprocess.run([self.xset, *args], capture_output=True, text=True,
                                  timeout=2, check=False).stdout
        except (OSError, subprocess.TimeoutExpired):
            return ""

    def _powers(self) -> list[Path]:
        try:
            lights = sorted(self.backlights.iterdir())
        except OSError:
            return []
        return [light / "bl_power" for light in lights
                if os.access(light / "bl_power", os.W_OK)]

    @staticmethod
    def _write(path: Path, value: str) -> bool:
        try:
            path.write_text(value + "\n", encoding="ascii")
        except OSError:
            return False
        return True

    def off(self) -> None:
        """Darkens the screen now."""
        powers = [power for power in self._powers() if self._write(power, "4")]
        if not powers and self.xset:
            self.dpms_was_on = "DPMS is Enabled" in self._xset("q")
            self._xset("dpms", "force", "off")
        self.dark = powers

    def on(self) -> None:
        """Lights the screen again, if off() darkened it."""
        if self.dark is None:
            return
        for power in self.dark:
            self._write(power, "0")
        if not self.dark and self.xset:
            self._xset("dpms", "force", "on")
            if not self.dpms_was_on:
                self._xset("-dpms")
        self.dark = None


def act(action: str, overlay: str | None, screen: Screen) -> None:
    """Does ACTION: suspends, opens the overlay's power options, or lights the
    screen when the window after a suspend closes."""
    log(action)
    if action == "settled":
        screen.on()
    elif action == "menu" and overlay:
        run([overlay, "--power"])
    elif action == "suspend" or not overlay:
        screen.off()
        run(["systemctl", "suspend"] if shutil.which("systemctl") else ["loginctl", "suspend"])


class Devices:
    """The power buttons among the input devices, found again every RESCAN."""

    def __init__(self) -> None:
        import evdev  # pylint: disable=import-outside-toplevel
        self.evdev = evdev
        self.selector = selectors.DefaultSelector()
        self.known: dict[str, object] = {}
        self.next_scan = 0.0

    def scan(self, now: float) -> None:
        """Adds the power buttons that appeared."""
        if now < self.next_scan:
            return
        self.next_scan = now + RESCAN
        ecodes = self.evdev.ecodes
        for path in self.evdev.list_devices():
            if path in self.known:
                continue
            try:
                device = self.evdev.InputDevice(path)
            except OSError:
                continue
            keys = device.capabilities().get(ecodes.EV_KEY, [])
            if any(key in keys for key in BUTTON_KEYS) and len(keys) <= MAX_KEYS:
                self.known[path] = device
                self.selector.register(device, selectors.EVENT_READ)
                log(f"{path} ({device.name})")
            else:
                device.close()

    def values(self, timeout: float) -> list[int]:
        """The values of the button's events (1 down, 0 up, 2 repeat) that
        come within TIMEOUT seconds."""
        values: list[int] = []
        for key, _ in self.selector.select(timeout=max(timeout, 0.01)):
            device = key.fileobj
            try:
                events = list(device.read())
            except OSError:
                self.selector.unregister(device)
                self.known.pop(device.path, None)
                continue
            values += [event.value for event in events
                       if event.type == self.evdev.ecodes.EV_KEY and event.code in BUTTON_KEYS]
        return values


def main() -> int:
    """Wait for the power button until the session ends."""
    overlay = find_overlay()
    if overlay is None:
        log("retrobox-overlay is not installed: a hold suspends too")
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)
    devices = Devices()
    button = Button()
    screen = Screen()

    def handle(action: str | None) -> None:
        if not action:
            return
        act(action, overlay, screen)
        if action == "suspend" or (action == "menu" and not overlay):
            button.sleeping(time.monotonic())

    while True:
        now = time.monotonic()
        if button.woke(now, suspended_for()):
            screen.on()
        devices.scan(now)
        waits = [devices.next_scan - now, 1.0, button.timeout(now)]
        wait = min(w for w in waits if w is not None)
        for value in devices.values(wait):
            now = time.monotonic()
            if button.woke(now, suspended_for()):
                screen.on()
            handle({1: button.press, 0: button.release}.get(value, lambda _: None)(now))
        handle(button.tick(time.monotonic()))


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(main())
